rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Each user can read/write only their own files under these folders
    match /profile_images/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /verification_photos/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /trip_images/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Catch-all for any other path (e.g. future folders): require auth
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
